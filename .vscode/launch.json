{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    // 启动调试的快捷键是F5
    "version": "0.2.0",
    "configurations": [
        {
            "cwd": "${workspaceRoot}",
            "executable": "./build/artifacts/mspmo_demo",
            "name": "Debug mspmo_demo",
            "request": "launch",
            "type": "cortex-debug",

            "interface": "swd",

            "configFiles": [
                "interface/cmsis-dap.cfg",
                "mspm0.cfg"
            ],
            
            "servertype": "openocd",
            "searchDir": [],
            "runToEntryPoint": "main",
            "preLaunchTask": "build mspm0",
            "showDevDebugOutput": "raw",
            "liveWatch": {
                "enabled": true,
                "samplesPerSecond": 4
            },
            // 添加以下 RTT 配置
            "rttConfig": {
                "enabled": true,
                "address": "auto",
                "clearSearch": false,
                "decoders": [
                    {
                        "label": "",
                        "port": 0,
                        "type": "console",
                        "logfile": "${workspaceRoot}/build/log0.log"
                    },
                    {
                        "label": "",
                        "port": 1,
                        "type": "console",
                        "logfile": "${workspaceRoot}/build/trace1.log"
                    }
                ]
            }
        }
    ]
}